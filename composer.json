{
	"name": "total-security-expert/total-security-expert",
	"description": "Plugin de seguridad ligero para WordPress, por modulos que se activan por separado.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload-dev": {
		"psr-4": {
			"TotalSecurityExpert\\Tests\\Unit\\": "tests/unit/",
			"TotalSecurityExpert\\Tests\\Fixtures\\": "tests/fixtures/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"build": "@php bin/build-zip.php"
	},
	"scripts-descriptions": {
		"test": "Ejecuta los tests de PHPUnit.",
		"lint": "Ejecuta PHPCS (WordPress Coding Standards).",
		"lint:fix": "Corrige automaticamente lo que PHPCBF pueda.",
		"build": "Genera dist/total-security-expert-<version>.zip con el plugin."
	}
}
